{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "date": {"type": "string", "format": "date"},
    "url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "title", "url", "accessed_at", "locator"],
      "properties": {
        "id": {"$ref": "#/$defs/key"},
        "type": {"enum": ["official_project", "official_documentation", "official_leaderboard", "challenge_leaderboard", "paper", "supplement", "author_code", "official_data", "license"]},
        "title": {"type": "string", "minLength": 4},
        "url": {"$ref": "#/$defs/url"},
        "accessed_at": {"$ref": "#/$defs/date"},
        "locator": {"$ref": "#/$defs/locator"},
        "version": {"type": "string"},
        "commit": {"type": "string"},
        "archive_url": {"$ref": "#/$defs/url"},
        "notes": {"type": "string"}
      }
    },
    "locator": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {"section": {"type": "string"}, "table": {"type": "string"}, "page": {"type": "string"}, "row": {"type": "string"}, "column": {"type": "string"}, "entry_id": {"type": "string"}, "file": {"type": "string"}}
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "checked_at", "source_ids", "notes"],
      "properties": {"status": {"enum": ["pending", "verified", "disputed"]}, "checked_at": {"$ref": "#/$defs/date"}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "notes": {"type": "string"}}
    },
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}},
    "temporal_parameter": {
      "type": "object", "additionalProperties": false, "required": ["kind", "anchor", "description"],
      "properties": {
        "kind": {"enum": ["fixed", "range", "variable", "not_applicable", "unknown"]},
        "unit": {"enum": ["seconds", "frames", "actions", "observation_fraction"]},
        "value": {"type": "number", "minimum": 0},
        "min": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0},
        "frame_rate": {"type": "number", "exclusiveMinimum": 0},
        "anchor": {"type": "string", "minLength": 3},
        "description": {"type": "string", "minLength": 3}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "fixed"}}}, "then": {"required": ["unit", "value"]}},
        {"if": {"properties": {"kind": {"const": "range"}}}, "then": {"required": ["unit", "min", "max"]}},
        {"if": {"properties": {"kind": {"const": "variable"}}}, "then": {"required": ["unit"]}},
        {"if": {"properties": {"unit": {"const": "frames"}}, "required": ["unit"]}, "then": {"required": ["frame_rate"]}}
      ]
    }
  }
}
