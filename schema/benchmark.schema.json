{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "dataset_id", "release_id", "annotation_version", "task", "original_task_name", "target_id", "protocol", "split", "sample_selection", "inputs", "temporal", "training_policy", "evaluation", "metrics", "sources", "verification", "results", "snapshots"],
  "properties": {
    "schema_version": {"const": "0.1"}, "id": {"$ref": "#/$defs/id"}, "dataset_id": {"$ref": "#/$defs/id"},
    "release_id": {"$ref": "#/$defs/key"}, "annotation_version": {"type": "string"},
    "task": {"$ref": "#/$defs/key"}, "original_task_name": {"type": "string", "minLength": 3}, "target_id": {"$ref": "#/$defs/key"},
    "protocol": {"type": "object", "additionalProperties": false, "required": ["name", "source_ids"], "properties": {"name": {"type": "string", "minLength": 3}, "source_ids": {"$ref": "#/$defs/source_ids"}, "notes": {"type": "string"}}},
    "split": {"type": "object", "additionalProperties": false, "required": ["name", "source_ids"], "properties": {"name": {"type": "string", "minLength": 2}, "source_ids": {"$ref": "#/$defs/source_ids"}, "notes": {"type": "string"}}},
    "sample_selection": {"type": "object", "additionalProperties": false, "required": ["description", "source_ids"], "properties": {"description": {"type": "string", "minLength": 3}, "source_ids": {"$ref": "#/$defs/source_ids"}}},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["modalities", "representation", "available_information"], "properties": {"modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "representation": {"type": "string", "minLength": 3}, "available_information": {"type": "string", "minLength": 3}}},
    "temporal": {"type": "object", "additionalProperties": false, "required": ["observation_window", "anticipation_gap", "prediction_horizon"], "properties": {"observation_window": {"$ref": "#/$defs/temporal_parameter"}, "anticipation_gap": {"$ref": "#/$defs/temporal_parameter"}, "prediction_horizon": {"$ref": "#/$defs/temporal_parameter"}, "intention_horizon": {"$ref": "#/$defs/temporal_parameter"}}},
    "training_policy": {"type": "object", "additionalProperties": false, "required": ["external_data", "pretraining", "extra_supervision", "ensemble", "source_ids"], "properties": {"external_data": {"enum": ["allowed", "forbidden", "unknown"]}, "pretraining": {"enum": ["allowed", "forbidden", "unknown"]}, "extra_supervision": {"enum": ["allowed", "forbidden", "unknown"]}, "ensemble": {"enum": ["allowed", "forbidden", "unknown"]}, "notes": {"type": "string"}, "source_ids": {"$ref": "#/$defs/source_ids"}}},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["description", "aggregation", "parameters", "source_ids"], "properties": {"description": {"type": "string", "minLength": 3}, "aggregation": {"type": "string", "minLength": 3}, "parameters": {"type": "object"}, "source_ids": {"$ref": "#/$defs/source_ids"}}},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "direction", "unit", "definition", "aggregation", "evaluation_subset", "source_ids"], "properties": {"id": {"$ref": "#/$defs/key"}, "name": {"type": "string"}, "direction": {"enum": ["higher", "lower"]}, "unit": {"type": "string"}, "definition": {"type": "string", "minLength": 8}, "aggregation": {"type": "string"}, "evaluation_subset": {"type": "string"}, "valid_range": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false}, "top_k": {"type": "integer", "minimum": 1}, "threshold": {"type": "number"}, "label_space": {"type": "string"}, "parameters": {"type": "object"}, "source_ids": {"$ref": "#/$defs/source_ids"}}}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}, "verification": {"$ref": "#/$defs/verification"},
    "results": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "method_id", "configuration", "scores", "source_ids", "protocol_match", "verification", "status"], "properties": {
      "id": {"$ref": "#/$defs/key"}, "method_id": {"$ref": "#/$defs/key"},
      "configuration": {"type": "object", "additionalProperties": false, "required": ["description", "modalities", "external_data", "pretraining", "ensemble"], "properties": {"description": {"type": "string"}, "modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "external_data": {"type": "string"}, "pretraining": {"type": "string"}, "ensemble": {"type": "boolean"}, "evaluation_parameters": {"type": "object"}, "notes": {"type": "string"}}},
      "scores": {"type": "object", "minProperties": 1, "patternProperties": {"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$": {"type": "object", "additionalProperties": false, "required": ["value", "source_ids", "locator"], "properties": {"value": {"type": "number"}, "source_ids": {"$ref": "#/$defs/source_ids"}, "locator": {"$ref": "#/$defs/locator"}, "original_value": {"type": "number"}, "conversion": {"type": "string"}, "uncertainty": {"type": "string"}}}}, "additionalProperties": false},
      "source_ids": {"$ref": "#/$defs/source_ids"},
      "protocol_match": {"type": "object", "additionalProperties": false, "required": ["status", "source_ids", "locator", "notes"], "properties": {"status": {"enum": ["confirmed", "unclear", "mismatch"]}, "source_ids": {"$ref": "#/$defs/source_ids"}, "locator": {"$ref": "#/$defs/locator"}, "notes": {"type": "string"}}},
      "verification": {"$ref": "#/$defs/verification"}, "status": {"enum": ["active", "withdrawn"]}, "correction_note": {"type": "string"},
      "baseline_origin": {"enum": ["dataset_authors", "protocol_authors", "none"]}
    }}},
    "snapshots": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "checked_at", "scope", "source_ids", "result_ids", "coverage_notes"], "properties": {"id": {"$ref": "#/$defs/key"}, "checked_at": {"$ref": "#/$defs/date"}, "scope": {"enum": ["official_leaderboard", "paper_reported"]}, "source_ids": {"$ref": "#/$defs/source_ids"}, "result_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "coverage_notes": {"type": "string"}, "first_place_confirmed": {"type": "boolean"}}}}
  }
}
